#!/usr/bin/python3
"""Source-level negative controls. For each control, in a COPY of the project (the tree is never mutated):

  1. run the named tests on the untouched copy            -> must pass
  2. revert one guarded behaviour in the copy (one source edit) and run the same tests -> must FAIL by assertion
  3. restore the file from the tree and run again          -> must pass

Compile errors do not count as a failure of the guarded behaviour. Output goes to <out>/run-<epoch>/<name>/ (default <out> is
.evidence/r1/negative-controls; --out DIR changes it; --jobs N runs N controls at once, default 1). The logs stay. Each worker keeps one warm
copy, <out>/run-<epoch>/copy-w<N>, for the whole invocation: every row first syncs the listed items from the repo into it (the repo's mtimes,
files the repo lacks deleted, .build never touched), so only the mutated file's dependents rebuild. The copies are removed at the end
(CLAWD_NC_KEEP_COPY=1 keeps them).
Prints `NEGATIVE-CONTROL: <name> -> fails` only for a control that failed at step 2 and passed at steps 1 and 3.
Usage: scripts/negative-controls [--out DIR] [--jobs N] [name ...]      (default: all)
       scripts/negative-controls --anchors [name ...]   (exit 1 and the stale list when a row's anchor is no longer in its file; runs no suite)
"""
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
import os
import re
import shutil
import subprocess
import sys
import threading
import time

repo = Path(__file__).resolve().parent.parent
output = repo / ".evidence" / "r1" / "negative-controls"

