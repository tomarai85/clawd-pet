def sync_copy(copy, items):
    """Brings the warm copy to the repo's state for the listed items; nothing else in it (.build above all) is synced or deleted."""
    for item in items:
        source = repo / item
        destination = copy / item
        destination.parent.mkdir(parents=True, exist_ok=True)
        if source.is_dir():
            shutil.copytree(source, destination, ignore=shutil.ignore_patterns(*_IGNORED), copy_function=_copy_changed, dirs_exist_ok=True)
            _prune(source, destination)
        else:
            _copy_changed(source, destination)
    scripts = copy / "scripts"
    if scripts.is_dir() and "scripts" not in items:      # an earlier row copied all of scripts/; this one holds the one file only
        for entry in list(scripts.iterdir()):
            if entry.name != "check-chat-fixtures.py":
                shutil.rmtree(entry, ignore_errors=True) if entry.is_dir() else entry.unlink()

