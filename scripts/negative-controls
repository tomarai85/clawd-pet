def run_control(name, output):
    copy = worker_copy(output)
    copy.mkdir(parents=True, exist_ok=True)
    began = time.time()
    lines, ok = run_in_copy(name, output, copy)
    return lines + [f"{name}: wall {time.time() - began:.0f} s ({copy.name})"], ok


def run_in_copy(name, output, copy):
    relative, edits, filters, expected, *more = CONTROLS[name]
    regenerate = more[0] if more else []
    lines, ok = [], False
    # launcher/ and launchd/ (64 KB) are read by ExamBrowser_plistAndLauncherAreUnchanged and FocusTests: without them every row that runs
    # those tests fails before any mutation and proves nothing.
    (output / name).mkdir(parents=True, exist_ok=True)
    sync_copy(copy, ("Package.swift", "Sources", "Tests", "Vendor", "art", "launcher", "launchd", "chat-page", "bin") + (("scripts",) if regenerate else ("scripts/check-chat-fixtures.py",)))
    target = copy / relative
    original = (repo / relative).read_text()
    base_rc, _ = run_tests(copy, filters, output / name / "1-before.log")
    altered = original
    for before, after in edits:
        if altered.count(before) != 1:
            return [f"{name}: guard anchor changed in {relative}: {before!r}"], False
        altered = altered.replace(before, after)
    target.write_text(altered)
    regenerated = regenerate_art(copy, regenerate, output / name / "regenerate-reverted.log")
    (output / name / "mutation.txt").write_text(f"{relative}\n" + "\n".join(f"- {b}\n+ {a}" for b, a in edits) + "\n")
    bad_rc, bad_text = run_tests(copy, filters, output / name / "2-reverted.log")
    target.write_text(original)
    regenerated = regenerated and regenerate_art(copy, regenerate, output / name / "regenerate-restored.log")
    good_rc, _ = run_tests(copy, filters, output / name / "3-restored.log")
    compile_error = re.search(r"error:.*\n.*Build failed|Compiling .*error", bad_text) is not None and "\u2718" not in bad_text
    failed_by_assertion = bad_rc != 0 and "\u2718" in bad_text and not compile_error
    named = [t for t in expected if re.search("\u2718 Test " + re.escape(t) + r"\((?:\w+:)*\)", bad_text)]   # a parameterized test prints its labels: name(travel:)
    ok = base_rc == 0 and regenerated and failed_by_assertion and len(named) == len(expected) and good_rc == 0
    lines.append(f"{name}: before rc={base_rc}, reverted rc={bad_rc} (failing: {', '.join(named) or 'none'}), restored rc={good_rc}")
    lines.append(f"NEGATIVE-CONTROL: {name} -> fails" if ok else f"NEGATIVE-CONTROL NOT PROVEN: {name}")
    return lines, ok


def check_anchors(chosen):
    """--anchors: runs nothing and writes nothing. Every `before` of every chosen row must be found in its file, applied one edit after the
    other to the text as run_control does, exactly once (run_control refuses any other count), and must change the text. Every test a row
    expects to turn red must exist as a test function under Tests/: run_control matches the names exactly, so a misspelt or renamed test
    could never be reported red."""
    problems = []
    tests = set()
    for source in (repo / "Tests").rglob("*.swift"):
        tests.update(re.findall(r"\bfunc\s+(\w+)\s*\(", source.read_text(errors="replace")))
    for name in chosen:
        relative, edits, _, expected, *_ = CONTROLS[name]
        for test in expected:
            if test not in tests:
                problems.append(f"{name}: expects the test {test}, which no test function under Tests/ is named")
        text = (repo / relative).read_text()
        for before, after in edits:
            count = text.count(before)
            if count != 1:
                problems.append(f"{name}: anchor found {count} times in {relative} (a row needs exactly one): {before[:60]!r}")
            elif before == after:
                problems.append(f"{name}: an edit that changes nothing: {before[:60]!r}")
            else:
                text = text.replace(before, after, 1)
    for line in problems:
        print(line, file=sys.stderr)
    stale = len({line.split(":", 1)[0] for line in problems})
    print(f"negative-controls anchors: {len(chosen) - stale} of {len(chosen)} row(s) apply")
    return 1 if problems else 0


def main(argv):
    global output
    args, out, jobs, names, anchors = list(argv), output, 1, [], False
    while args:
        item = args.pop(0)
        if item == "--anchors":
            anchors = True
        elif item == "--out":
            out = Path(args.pop(0)).resolve()
        elif item == "--jobs":
            jobs = int(args.pop(0))
        else:
            names.append(item)
    unknown = [n for n in names if n not in CONTROLS]
    if unknown:
        print("unknown control(s): " + ", ".join(unknown), file=sys.stderr); return 2
    if anchors:
        return check_anchors(names or list(CONTROLS))
    output = out / f"run-{int(time.time())}"      # every run gets its own directory; logs are never deleted, each copy is (run_control)
    output.mkdir(parents=True, exist_ok=False)
    lock = threading.Lock()
    failures = 0

    def one(name):
        lines, ok = run_control(name, output)
        with lock:
            for line in lines:
                print(line, file=sys.stdout if "NOT PROVEN" not in line else sys.stderr, flush=True)
        return ok

    try:
        with ThreadPoolExecutor(max_workers=max(1, jobs)) as pool:
            results = list(pool.map(one, names or list(CONTROLS)))
    finally:
        # The warm copies (about 400 MB each with their build) are scratch; the logs and mutation.txt are the evidence.
        # CLAWD_NC_KEEP_COPY=1 keeps them, to debug a row.
        if not os.environ.get("CLAWD_NC_KEEP_COPY"):
            for warm in output.glob("copy-w*"):
                shutil.rmtree(warm, ignore_errors=True)
    failures = results.count(False)
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
