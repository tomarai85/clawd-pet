def _d4_tests():
    names = []
    for part in ("Queue", "Steer", "Send", "Store", "Page"):
        names += re.findall(r"\bfunc\s+(\w+)\s*\(", (repo / f"Tests/ClawdCoreTests/ChatOrcaParityD{part}Tests.swift").read_text())
    return names


def _t(*fragments):
    """The full name of the one test function whose name holds every fragment (a row names its tests by a few words, never by retyping them)."""
    found = [n for n in _d4_tests() if all(f in n for f in fragments)]
    assert len(found) == 1, f"{fragments}: {found}"
    return found[0]


def _row(file, edits, *tests):
    names = [_t(*(t if isinstance(t, tuple) else (t,))) for t in tests]
    return (file, edits, names, names)


