def run_tests(copy, filters, log):
    command = ["swift", "test", "--disable-index-store"] + [arg for f in filters for arg in ("--filter", f)]
    result = subprocess.run(command, cwd=copy, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    text = re.sub(r"\x1b\[[0-9;]*m", "", result.stdout)
    log.write_text(text)
    return result.returncode, text


def regenerate_art(copy, commands, log):
    """Runs the row's regenerate commands in the copy. False when one fails (the row is then not proven)."""
    text = ""
    for command in commands:
        result = subprocess.run(command, cwd=copy, env=dict(os.environ, PYTHONDONTWRITEBYTECODE="1"), stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        text += f"$ {' '.join(command)}\n{result.stdout}\nrc={result.returncode}\n"
        if result.returncode != 0:
            log.write_text(text)
            return False
    if commands:
        log.write_text(text)
    return True


_IGNORED = (".DS_Store", "preview-check")
_workers = threading.local()
_worker_count = [0]
_worker_lock = threading.Lock()


def worker_copy(output):
    """The warm copy of this worker: one fixed path under the output folder for the whole invocation, so .build survives from row to row."""
    if not hasattr(_workers, "index"):
        with _worker_lock:
            _workers.index = _worker_count[0]
            _worker_count[0] += 1
    return output / f"copy-w{_workers.index}"


def _copy_changed(source, destination):
    """copy2 (the repo's mtime comes back), skipped when size and mtime already agree, so an unchanged file is not rewritten."""
    try:
        a, b = os.stat(source), os.stat(destination)
        if a.st_size == b.st_size and a.st_mtime_ns == b.st_mtime_ns:
            return destination
    except OSError:
        pass
    return shutil.copy2(source, destination)


def _prune(source, destination):
    """Deletes what the repo does not have under a synced directory of the copy. .build is never touched."""
    for entry in list(destination.iterdir()):
        if entry.name == ".build":
            continue
        peer = source / entry.name
        if entry.name in _IGNORED or not peer.exists() and not peer.is_symlink():
            if entry.is_dir() and not entry.is_symlink():
                shutil.rmtree(entry, ignore_errors=True)
            else:
                entry.unlink()
        elif entry.is_dir() and not entry.is_symlink() and peer.is_dir():
            _prune(peer, entry)


