# SA6: the Voice section's CLI verbs. The status row runs sections 1 to 2b of Tests/cli.test.sh, the gate row up to 3a, and the restart line's row
# runs Tests/update.test.sh, where the restart plumbing is.
CLI_2B_ENV = {"CLAWD_TEST_STOP_AFTER": "2b"}
CLI_UPDATE = ("bin/clawd-pet", ["bash", "Tests/update.test.sh"], "cli")
CONTROLS.update({
    # `status` without Aqua Voice installed prints the version line and the warning again.
    "sa6-cli-status-warns-without-aqua": (CLI, [
        ('  if [ ! -e "$AQUA_INFO_PLIST" ]; then\n    echo "Aqua Voice: not installed"\n    return 0\n  fi\n', '')], CLI_2B_ENV,
        ["status without Aqua Voice installed says so"]),
    # `aqua follow extra` is accepted (the third word is ignored). Since SA6-5 the word-count gate refuses it first, so both checks go.
    "sa6-cli-aqua-follow-extra-accepted": (CLI, [
        ('if [ "${2:-}" = react ]; then [ $# -le 3 ]; else [ $# -le 2 ]; fi || { usage >&2; exit 2; }', '[ $# -le 3 ] || { usage >&2; exit 2; }'),
        ('      [ -z "${2:-}" ] || { usage >&2; exit 2; }\n', '')], CLI_3A_ENV,
        ["invalid 'aqua follow extra' exits 2"]),
    # SA6-5: the gate counts aqua follow|ignore|auto's words as react's, so an empty third word gets through and the setting is written.
    "sa6res-cli-aqua-empty-third-word-accepted": (CLI, [
        ('if [ "${2:-}" = react ]; then [ $# -le 3 ]; else [ $# -le 2 ]; fi || { usage >&2; exit 2; }', '[ $# -le 3 ] || { usage >&2; exit 2; }')],
        CLI_3A_ENV, ["aqua follow with an empty third word exits 2"]),
    # With aquaReact false, `aqua follow` prints the "applied" line again instead of what is in effect.
    "sa6-cli-react-off-message-dropped": (CLI_UPDATE, [
        ('    if [ "$AQUA_REACT_OFF" = 1 ]; then\n', '    if false; then\n')], {},
        ["5b: ... and says saved; in effect: ignore (React is off)"]),
