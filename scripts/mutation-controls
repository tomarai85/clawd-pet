EXPECTED_FAILS.update({
    "attended-history-broken-events-complete": ["a torn event: the history line says incomplete and names the count",
                                                "unknown lines: the history line says incomplete and names the count"],
})
def apply_edits(name):
    """Control `name`'s file with its edits applied once each, in order, and None; or None and the line that names the first missing anchor."""
    (relative, _, _), edits, _, _ = CONTROLS[name]
    altered = (repo / relative).read_text()
    for before, after in edits:
        if before not in altered:
            return None, f"{name}: mutation anchor not found in {relative}: {before[:70]!r}"
        altered = altered.replace(before, after, 1)
    return altered, None


def run_control(name, output):
    (relative, command, group), edits, env_extra, expected = CONTROLS[name]
    if expected == [] and name in EXPECTED_FAILS:
        expected = EXPECTED_FAILS[name]
    folder = output / name
    tree = folder / "tree"
    target = make_tree(tree, relative)
    altered, missing = apply_edits(name)
    if missing:
        return [missing], False
    target.write_text(altered)
    target.chmod((repo / relative).stat().st_mode & 0o777)
    (folder / "mutation.txt").write_text(f"{relative}\n" + "\n".join(f"- {b}\n+ {a}" for b, a in edits) + "\n")
    environment = dict(os.environ); environment.update(env_extra)
    result = subprocess.run(command, cwd=tree, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=environment)
    (folder / "run.log").write_text(result.stdout)
    fails = [line for line in result.stdout.splitlines() if line.startswith("FAIL")]
    summary = [line for line in result.stdout.splitlines() if re.search(r"pass=\d+ fail=\d+$", line)]
    last = summary[-1] if summary else "(no summary line)"
    if expected is None:       # identity control: the unmutated copy must pass
        ok = result.returncode == 0 and bool(summary) and summary[-1].endswith("fail=0")
        return [f"{name}: rc={result.returncode} {last}", f"IDENTITY-CONTROL: {name} -> {'passes' if ok else 'DOES NOT PASS'}"], ok
    named = [text for text in expected if any(text in line for line in fails)]
    ok = result.returncode != 0 and bool(fails) and len(named) == len(expected)
    shown = "; ".join(fail[:90] for fail in fails[:2])
    lines = [f"{name}: rc={result.returncode} {last}; first FAIL lines: {shown}"]
    lines.append(f"NEGATIVE-CONTROL: {name} -> fails" if ok else f"NEGATIVE-CONTROL NOT PROVEN: {name}")
    return lines, ok


def check_anchors(chosen):
    """--anchors: runs nothing and writes nothing. For every chosen row, applies its edits one after the other to the text of its target file
    (as run_control does) and requires each `before` to be found, to change the text, and (rows of the attended menu check) to be found exactly
    once, so that the first occurrence a row replaces is the one it names. A row applies when it names a FAIL line and every edit passes.
    Exit 0 when every chosen row applies."""
    found = total = 0
    problems = []
    applying = 0
    for name in chosen:
        before_problems = len(problems)
        (relative, command, group), edits, env_extra, expected = CONTROLS[name]
        if expected == [] and name not in EXPECTED_FAILS:
            problems.append(f"{name}: no FAIL line is named for this row")
        text = (repo / relative).read_text()
        for before, after in edits:
            total += 1
            count = text.count(before)
            if count < 1:
                problems.append(f"{name}: mutation anchor not found in {relative}: {before[:80]!r}")
            elif before == after:
                problems.append(f"{name}: an edit that changes nothing: {before[:80]!r}")
            elif count > 1 and name.startswith("attended-menu-"):
                problems.append(f"{name}: anchor found {count} times in {relative} (a menu row needs exactly one): {before[:80]!r}")
            else:
                found += 1
                text = text.replace(before, after, 1)
        applying += len(problems) == before_problems
    for line in problems:
        print(line, file=sys.stderr)
    print(f"anchors: {found}/{total} found in {len(chosen)} row(s)")
    print(f"mutation-controls anchors: {applying} of {len(chosen)} control(s) apply")
    return 0 if not problems else 1


def main(argv):
    args, out, jobs, group, names, anchors = list(argv), repo / ".evidence" / "r3" / "negative-controls" / "shell", 1, "all", [], False
    while args:
        item = args.pop(0)
        if item == "--anchors":
            anchors = True
        elif item == "--out":
            out = Path(args.pop(0)).resolve()
        elif item == "--jobs":
            jobs = int(args.pop(0))
        elif item == "--group":
            group = args.pop(0)
        else:
            names.append(item)
    unknown = [n for n in names if n not in CONTROLS]
    if unknown:
        print("unknown control(s): " + ", ".join(unknown), file=sys.stderr); return 2
    chosen = names or [n for n, spec in CONTROLS.items() if group in ("all", spec[0][2])]
    if anchors:   # only that every chosen row still applies to today's files; no suite runs, nothing is written
        return check_anchors(chosen)
    output = out / f"run-{int(time.time())}"
    output.mkdir(parents=True, exist_ok=False)
    lock = threading.Lock()
    kept = []

    def one(name):
        lines, ok = run_control(name, output)
        with lock:
            for line in lines:
                kept.append(line)
                print(line, file=sys.stdout if "NOT PROVEN" not in line and "DOES NOT" not in line else sys.stderr, flush=True)
        return ok

    with ThreadPoolExecutor(max_workers=max(1, jobs)) as pool:
        results = list(pool.map(one, chosen))
    commit = subprocess.run(["git", "rev-parse", "--short", "HEAD"], cwd=repo, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True).stdout.strip()
    header = [f"mutation-controls run {time.strftime('%Y-%m-%d %H:%M:%S')} commit {commit or 'unknown'}: {len(chosen)} control(s), {sum(1 for r in results if r)} proven, {sum(1 for r in results if not r)} not proven"]
    (output / "summary.txt").write_text("\n".join(header + sorted(kept)) + "\n")
    return 0 if all(results) else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
