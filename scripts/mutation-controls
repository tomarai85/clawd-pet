# ---- the attended menu check (`--menu`, design-clawd-pet-v2-sM-attended.md v3.2, section 8.3): 47 rows. Each mutates ONE rule of scripts/attended-check.sh
#      (the Perl program MENU_PERL inside it, or the shell around it) and is run against the one scenario that names it (CLAWD_TEST_ONLY), whose
#      checks must turn red; "attended-identity-control" (above) runs the whole suite unmutated. ----
def menu_row(name, scenario, red, edits):
    CONTROLS[name] = (ATTENDED, edits, {"CLAWD_TEST_ONLY": "^scn_" + scenario + "$"}, [scenario + ": " + red])

def menu_row_scenarios(name, pairs, edits):
    """A row whose one mutation must turn red a check in each of several scenarios: pairs = [(scenario, red), ...]."""
    CONTROLS[name] = (ATTENDED, edits, {"CLAWD_TEST_ONLY": "^scn_(" + "|".join(scenario for scenario, _ in pairs) + ")$"}, [scenario + ": " + red for scenario, red in pairs])

