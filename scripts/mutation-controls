# ---- Sprint 10: four false-PASS paths Codex found in the check scripts (spec 9b item 16, round-brief-clawd-pet-v2-s10.md) ----
ROTATION_NOW = '  if { [ "$LOG_I0" != none ] && { [ "$LOG_I1" != "$LOG_I0" ] || [ "$ROT_NOW_I" != "$LOG_I0" ]; }; } || [ "$LOG_S1" -lt "$LOG_S0" ] || [ "$LOG1_SIG1" != "$LOG1_SIG0" ] || [ "$ROT_NOW_L1" != "$LOG1_SIG0" ]; then ROTATED=1; fi\n'
ROTATION_AT_THE_FREEZE = '  if { [ "$LOG_I0" != none ] && [ "$LOG_I1" != "$LOG_I0" ]; } || [ "$LOG_S1" -lt "$LOG_S0" ] || [ "$LOG1_SIG1" != "$LOG1_SIG0" ]; then ROTATED=1; fi\n'
END_READ_STATUS = '  read_status 1 || notrun status-unreadable "status.json could not be read at the end of the window"\n'
# since the retained logs are scanned whole, a rotation that goes unseen no longer hides the violation itself (it stays a FAIL); what it hides is the
# window's INPUT lines in the rotated file, so the scenarios turn red on their not-run codes (too-few-mousedowns, no-drag-sequence)
A_AFTER_FREEZE = "a FOCUS_VIOLATION in the window, then agent.log rotated right after the end facts were frozen: not-run codes []"
A_BETWEEN_READS = "a FOCUS_VIOLATION in the window, agent.log rotates between the read of the INPUT bytes and the read of the violations: not-run codes []"
EXPECTED_FAILS.update({
    # finding a: a rotation after the end facts were frozen, or between two reads of the analysis, must not hide a violation
    "attended-rotation-after-the-freeze-not-seen": [A_AFTER_FREEZE, A_BETWEEN_READS,
        "rotation after the freeze, no violation: the rotation is noted"],
    "attended-analysis-not-repeated-when-the-log-rotates-during-it": ["rotation between the reads: the violation in the rotated file is counted",
        "a log that keeps rotating: the evidence says that no analysis saw one generation"],
    # finding b: the time inside a window-list read is unobserved
    "dx-slow-read-between-two-reads-counted-as-observed-time": ["a read of the window list that takes 0.5 s, between two fast ones: verdict NOT RUN"],
