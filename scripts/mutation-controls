PUBLISH_FILE_FLUSH = '  flush_durable "$1" || die "could not flush $1 to the disk; it was not moved into place"\n'
PUBLISH_MV = '  mv "$1" "$2" || die "$3"\n'
PUBLISH_DIR_FLUSH = '  flush_durable "${2%/*}" || die "could not flush ${2%/*} to the disk after moving $2 into place"\n'
SET_FILE_FLUSH = '    flush_durable "${partials[@]}" || die "could not flush the ${#partials[@]}-copy set starting at ${partials[0]} to the disk; none of it was moved into place"\n'
SET_MV = '    for name in "${files[@]}"; do mv "$name.partial" "$name" || die "could not move $name into place"; done\n'
SET_DIR_FLUSH = '    flush_durable "${dirs[@]}" || die "could not flush the directories of the ${#files[@]}-file set starting at ${files[0]} to the disk after moving it into place"\n'
OPEN_FLAGS = "O_RDONLY | O_NONBLOCK | O_NOFOLLOW"
CHUNK_CASE = 'case "$FLUSH_CHUNK" in \'\'|*[!0-9]*|0*) FLUSH_CHUNK=400 ;; *) [ "${#FLUSH_CHUNK}" -le 3 ] && [ "$FLUSH_CHUNK" -le 400 ] || FLUSH_CHUNK=400 ;; esac\n'
FLUSH_ART_TREE = '  flush_durable "$ROOT/art" ${art_dirs[@]+"${art_dirs[@]}"} || die "could not flush the directories of $ROOT/art to the disk; the catalogs, the agent and the CLI were not moved into place"\n'
FLUSH_UPTODATE = '    flush_durable "$ROOT/art" ${art_dirs[@]+"${art_dirs[@]}"} || die "could not flush the directories of $ROOT/art to the disk (nothing else was changed)"\n'
PICTURES_LOOP = '  for rel in ${diff_rel[@]+"${diff_rel[@]}"} ${new_rel[@]+"${new_rel[@]}"}; do\n    case "$rel" in */*) batch+=("$rel") ;; esac\n  done\n'
# the code before this round: a new picture is copied, a directory at a time, straight to its final name
STRAIGHT_COPY = (
    '  for rel in ${diff_rel[@]+"${diff_rel[@]}"}; do\n    case "$rel" in */*) batch+=("$rel") ;; esac\n  done\n'
    '  nb=(); batch_dir=""\n'
    '  for rel in ${new_rel[@]+"${new_rel[@]}"}; do\n'
    '    case "$rel" in */*) ;; *) continue ;; esac\n'
    '    d="${rel%/*}"\n'
    '    if [ "$d" != "$batch_dir" ] || [ "${#nb[@]}" -ge 100 ]; then\n'
    '      if [ "${#nb[@]}" -gt 0 ]; then cp -- "${nb[@]}" "$ROOT/art/$batch_dir/" || die "copy failed: $ROOT/art/$batch_dir"; fi\n'
    '      nb=(); batch_dir="$d"\n'
    '    fi\n'
    '    nb+=("$repo/art/$rel")\n'
    '  done\n'
    '  if [ "${#nb[@]}" -gt 0 ]; then cp -- "${nb[@]}" "$ROOT/art/$batch_dir/" || die "copy failed: $ROOT/art/$batch_dir"; fi\n')
