def make_tree(root, relative):
    """A copy of the project made of symlinks, with `relative` replaced by a real file the caller may then mutate. Every directory on the
    way to that file is a real directory of symlinks; everything else is linked."""
    root.mkdir(parents=True)
    parts = Path(relative).parts

    def populate(source, destination, depth):
        for entry in source.iterdir():
            if depth == 0 and entry.name in (".git", ".evidence"):
                continue
            link = destination / entry.name
            if depth == 0 and entry.name == ".build":
                # A real directory of symlinks, not a symlink: paths made under it must be canonical, because the agent compares
                # proc_pidpath() (always the resolved path) with the install path built from $HOME.
                link.mkdir()
                for child in entry.iterdir():
                    # Scratch directories of the suites (cli-test, interrupt-test, attended-check-test, post-install-check-test, lsof-test, test-artifacts, ...) are not linked: the copy
                    # makes its own, so every path the suites build stays canonical.
                    if child.name.endswith("-test") or child.name == "test-artifacts" or child.name.startswith("dbg"):
                        continue
                    (link / child.name).symlink_to(child)
            elif depth == 0 and entry.name == "chat-page" and entry.is_dir() and parts[0] != "chat-page":
                # The installer refuses a symlinked chat-page directory or a symlinked file in it (bin/clawd-pet, "chat page incomplete"), so the
                # copy gets real files; nothing mutates them.
                shutil.copytree(entry, link)
            elif depth < len(parts) - 1 and entry.name == parts[depth]:
                link.mkdir()
                populate(entry, link, depth + 1)
            elif depth == len(parts) - 1 and entry.name == parts[depth]:
                continue                       # the file under test: the caller writes its mutated copy
            else:
                link.symlink_to(entry)

    populate(repo, root, 0)
    (root / ".evidence").mkdir()
    return root / relative


