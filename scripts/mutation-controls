#!/usr/bin/python3
"""Negative controls for the shell suites. For each control, in a COPY of the project (the tree is never mutated):

  - the copy is a directory of symlinks to the tree, except the directory that holds the one file being mutated, which is a real
    directory of symlinks with that one file replaced by a mutated copy; `.build` is shared so the helpers and the agent are found;
  - the suite is run against the copy with the mutation applied; it must FAIL (non-zero exit, and its `FAIL` lines named below);
  - the identity control (no mutation) must PASS, which proves the copy itself is faithful.

Prints `NEGATIVE-CONTROL: <name> -> fails` for a control whose mutated copy failed the suite as expected. Logs go to
<out>/run-<epoch>/<name>/ (default .evidence/r3/negative-controls/shell). Nothing is ever deleted. The lines it prints are also kept in
<out>/run-<epoch>/summary.txt (with the commit and the date), so a run leaves its own evidence next to the per-control logs.
Usage: scripts/mutation-controls [--out DIR] [--jobs N] [--group lsof|cli|attended|post|interrupt|update|all] [name ...]
       scripts/mutation-controls --anchors [--group ...] [name ...]   (exit 1 when a row's anchor is no longer in its file; runs no suite)
       --anchors covers every row unless names or --group are given; each row's edits are applied in order, each anchor must be found and
       change the text, and an attended-menu row's anchor must be found exactly once.
"""
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
import os
import re
import shutil
import subprocess
import sys
import threading
import time

repo = Path(__file__).resolve().parent.parent

