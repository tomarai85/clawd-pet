#!/bin/sh
# Independent post-uninstall checker: the same enumeration source as the agent's --own-pids, built as its own
# executable, because the installed binary is gone by then. Prints PID lines and a final "OWN-PIDS n".
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for checker in "$repo/.build/release/clawd-own-pids" "$repo/.build/debug/clawd-own-pids"; do
  if [ -x "$checker" ]; then exec "$checker"; fi
done
echo 'Independent PID checker missing; run swift build' >&2
exit 2
