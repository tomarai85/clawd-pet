#!/bin/bash
# Stub lsappinfo for the attended-check tests: the system's own answer to "which application is frontmost".
#   lsappinfo front                    prints an ASN; lsappinfo info -only pid ASN prints "pid"=<n>
# The pid is the content of $STUB_DIR/front.now, which the stub sampler keeps current (its `front` action changes it together with the
# value the sampler prints; its `world` action changes only this one, which is a sampler that reports a stale value).
# The script says who asks in the variable CLAWD_LSAPPINFO_CALLER: `proof` (the default: the checks at the two ends of the window),
# `window-poll` (the looks the script takes inside the window, every 0.2 s or so) or `end-read-poll` (the looks it takes while it reads
# the stage window at the end, which can last seconds). The three kinds are counted apart, so a hook on "the 3rd proof call" lands at the
# end of the window however many looks the window and the end read made:
#   $STUB_DIR/lsappinfo.fail         every call exits 1 (lsappinfo unreadable)
#   $STUB_DIR/lsappinfo.poll.fail    every window-poll call exits 1 (and no other)
#   $STUB_DIR/lsappinfo.endread.fail every end-read-poll call exits 1 (and no other)
#   $STUB_DIR/lsappinfo.hook.N       a shell command run at the start of the Nth proof call (calls are counted per command, front and info
#                                    alike); the tests use it to append agent.log lines at an exact point of the script's run
#   $STUB_DIR/lsappinfo.poll.hook.N     the same for the Nth window-poll call
#   $STUB_DIR/lsappinfo.endread.hook.N  the same for the Nth end-read-poll call
# The calls are recorded in $STUB_DIR/lsappinfo.calls (proof), lsappinfo.poll.calls (window-poll) and lsappinfo.endread.calls (end-read-poll).
caller="${CLAWD_LSAPPINFO_CALLER:-proof}"
case "$caller" in
  window-poll) kind=lsappinfo.poll ;;
  end-read-poll) kind=lsappinfo.endread ;;
  *) kind=lsappinfo ;;
esac
echo "lsappinfo $*" >> "$STUB_DIR/$kind.calls"
n=$(( $(cat "$STUB_DIR/$kind.count" 2>/dev/null || echo 0) + 1 ))
echo "$n" > "$STUB_DIR/$kind.count"
[ ! -f "$STUB_DIR/$kind.hook.$n" ] || bash "$STUB_DIR/$kind.hook.$n"
[ ! -f "$STUB_DIR/lsappinfo.fail" ] || exit 1
[ ! -f "$STUB_DIR/$kind.fail" ] || exit 1
case "${1:-}" in
  front) printf 'ASN:0x0-0xcb3cb3:\n'; exit 0 ;;
  info)
    pid="$(cat "$STUB_DIR/front.now" 2>/dev/null)"
    [ -n "$pid" ] || exit 1
    printf '"pid"=%s\n' "$pid"; exit 0 ;;
esac
exit 1
